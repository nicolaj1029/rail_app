# Toggle usage of live external APIs (DB transport.rest, SNCF/Navitia, RNE mock)
USE_LIVE_APIS=false

# AIR lookup providers. Set one or both API keys only in the production environment.
AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1/flights
AIR_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
AIR_PROVIDER_TIMEOUT_SECONDS=5
AIR_PROVIDER_MIN_REQUEST_INTERVAL_MS=1100
AIR_LOOKUP_BUDGET_SECONDS=8
AIR_ACTIVE_CACHE_SECONDS=60
AIR_FUTURE_CACHE_SECONDS=900
AIR_HISTORICAL_CACHE_SECONDS=86400
AIR_NO_DATA_CACHE_SECONDS=60

# Admin routes fail closed unless at least one password of 12+ characters is configured.
ADMIN_AUTH_ENABLED=true
ADMIN_JURIST_USER=jurist
ADMIN_JURIST_PASS=
ADMIN_OPERATOR_USER=operator
ADMIN_OPERATOR_PASS=

# DB transport.rest base (public community API)
DB_TRANSPORT_REST_BASE=https://v6.db.transport.rest

# SNCF/Navitia API
SNCF_NAVITIA_BASE=https://api.sncf.com
SNCF_API_KEY=

# RNE mock/live base (used by RneClient)
RNE_BASE_URL=http://localhost:5555/api/providers/rne
